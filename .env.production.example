# Production environment variables for docker-compose
# Copy to .env.production and set secure values BEFORE deploying

# REQUIRED: Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET

# Frontend origin for CORS
CORS_ORIGIN=https://your-domain.com

# Set to true for HTTPS deployments
COOKIE_SECURE=true
