# Example environment variables for Ganesh
# Copy to .env and set secure values in production

# JWT secret used to sign tokens — set a strong random value
JWT_SECRET=change_me_to_a_strong_random_value

# Origin allowed for CORS (frontend origin)
CORS_ORIGIN=http://localhost:8000

# Node environment: development | production
NODE_ENV=development

# Server port
PORT=5000
